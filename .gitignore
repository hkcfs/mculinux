# Build artifacts
mculinux/output/
firmware/
mculinux/build/.cache/
mculinux/build/.espressif/
mculinux/build/.wget-hsts
mculinux/build/buildroot/
mculinux/build/crosstool-NG/
mculinux/build/esp-hosted/
mculinux/build/esp32s3/
mculinux/build/xtensa-dynconfig/*
!mculinux/build/xtensa-dynconfig/esp32s3.so
mculinux/build/autoconf-*/
mculinux/build/build-buildroot-*/
mculinux/build/kernel-src/
mculinux/build/.kernel-version
mculinux/build/linux-*src/
*.o
*.elf

# Allow prebuilt binaries (override *.bin rule for this path)
!mculinux/tools/prebuilt/**/*.bin

# Tools - allowlist prebuilt binaries
mculinux/tools/*
!mculinux/tools/gen_esp32part.py
!mculinux/tools/prebuilt/
!mculinux/tools/prebuilt/**

# Docker
docker-compose.override.yml

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
*.pyo

# Logs
*.log

# Temporary files
*.tmp
*.temp
mculinux/tools/prebuilt/binaries/*.bak

# Never commit assembled/stale images back into prebuilts
mculinux/tools/prebuilt/binaries/flash_*.bin
