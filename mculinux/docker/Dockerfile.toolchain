# MCUlinux toolchain base image (ghcr.io/hkcfs/mculinux/toolchain)
# Prebuilt xtensa-esp32s3-linux-muslfdpic GCC 14.0.1 (crosstool-NG).
# The toolchain is relocatable (verified: identical output from any prefix)
# and links only libc, so this image is just Ubuntu + a COPY.
#
# Built MANUALLY (CI checkouts lack the toolchain, so docker.yml does NOT
# build this — only builder/tester). Rebuild on toolchain updates (~yearly):
#   docker build -f mculinux/docker/Dockerfile.toolchain \
#     -t ghcr.io/hkcfs/mculinux/toolchain:gcc14.0.1-muslfdpic \
#     mculinux/build/crosstool-NG/builds/xtensa-esp32s3-linux-muslfdpic
#   docker tag ...:gcc14.0.1-muslfdpic .../toolchain:latest
#   docker push ... (both tags)
# Then bump TOOLCHAIN_IMAGE in Dockerfile.builder.

ARG UBUNTU_TAG=24.04
FROM ubuntu:${UBUNTU_TAG}

ENV DEBIAN_FRONTEND=noninteractive

# Context is the toolchain dir itself (see build command above).
COPY . /opt/crosstool-ng/xtensa-esp32s3-linux-muslfdpic/

RUN test -x /opt/crosstool-ng/xtensa-esp32s3-linux-muslfdpic/bin/xtensa-esp32s3-linux-muslfdpic-gcc
ENV PATH="/opt/crosstool-ng/xtensa-esp32s3-linux-muslfdpic/bin:${PATH}"

CMD ["bash"]
