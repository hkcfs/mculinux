# MCUlinux slim tester image (ghcr.io/hkcfs/mculinux/tester)
# QEMU + runtime only. Used by the fast CI path: assemble flash from
# committed prebuilts and boot-test it. No toolchain, no sources.
#
# Build from repo root:
#   docker build -f mculinux/docker/Dockerfile.tester -t mculinux-tester .
# Normally built by .github/workflows/docker.yml.

ARG UBUNTU_TAG=latest
FROM ubuntu:${UBUNTU_TAG}

ENV DEBIAN_FRONTEND=noninteractive

# ubuntu.com vhosts resolve intermittently from the GitHub-hosted runner
# fleet (transient "Could not resolve" errors that sink whole builds).
# Retry each fetch before giving up.
RUN printf 'Acquire::Retries "10";\n' > /etc/apt/apt.conf.d/80-retries

ARG QEMU_TARBALL_URL=https://github.com/espressif/qemu/releases/download/esp-develop-9.2.2-20260417/qemu-xtensa-softmmu-esp_develop_9.2.2_20260417-x86_64-linux-gnu.tar.xz

# QEMU runtime libs + basic tools for assemble/test scripts
# (python3: bootloader flash-size patching for 16MB+ images).
RUN apt-get update && apt-get -y install --no-install-recommends \
    bash coreutils file git ca-certificates wget xz-utils python3 \
    libgcrypt20 libglib2.0-0 libpixman-1-0 libsdl2-2.0-0 libslirp0 \
    && rm -rf /var/lib/apt/lists/*

# Espressif QEMU (esp32s3 machine). test-qemu.sh uses $QEMU first.
# GitHub release-asset downloads get dropped mid-stream occasionally
# (wget exit 4) - retry with resume and show errors on failure.
RUN mkdir -p /tmp/qextract /opt/qemu && \
    wget -nv --tries=5 --timeout=120 --continue "$QEMU_TARBALL_URL" -O /tmp/qemu.tar.xz && \
    tar -xf /tmp/qemu.tar.xz -C /tmp/qextract && \
    (test -d /tmp/qextract/qemu && cp -r /tmp/qextract/qemu/* /opt/qemu/ || \
     cp -r /tmp/qextract/* /opt/qemu/) && \
    rm -rf /tmp/qextract /tmp/qemu.tar.xz && \
    test -x /opt/qemu/bin/qemu-system-xtensa
ENV QEMU=/opt/qemu/bin/qemu-system-xtensa

WORKDIR /work
CMD ["bash"]
