From: MCUlinux ESP32-S3 port <hkcfs@example.com>
Subject: [PATCH] xtensa: ESP32 platform support (choice, Makefile, ISS gating, serial.h)

--- a/arch/xtensa/Kconfig
+++ b/arch/xtensa/Kconfig
@@ -47,6 +47,7 @@
 	select HAVE_GCC_PLUGINS if GCC_VERSION >= 120000
 	select HAVE_HW_BREAKPOINT if PERF_EVENTS
 	select HAVE_IRQ_TIME_ACCOUNTING
+	select HAVE_LD_DEAD_CODE_DATA_ELIMINATION
 	select HAVE_PAGE_SIZE_4KB
 	select HAVE_PCI
 	select HAVE_PERF_EVENTS
@@ -421,11 +422,27 @@
 	select SERIAL_CONSOLE
 	select XTENSA_CALIBRATE_CCOUNT
 	select PLATFORM_HAVE_XIP
-	help
-	  XTFPGA is the name of Tensilica board family (LX60, LX110, LX200, ML605).
-	  This hardware is capable of running a full Linux distribution.
-
-endchoice
+ 	help
+ 	  XTFPGA is the name of Tensilica board family (LX60, LX110, LX200, ML605).
+ 	  This hardware is capable of running a full Linux distribution.
+
+ config XTENSA_PLATFORM_ESP32
+ 	bool "ESP32"
+ 	select ESP32_INTC
+ 	select PLATFORM_HAVE_XIP
+ 	select PLATFORM_WANT_DEFAULT_MEM
+ 	select XIP_KERNEL
+ 	select XTENSA_CALIBRATE_CCOUNT
+ 	select XTENSA_LOAD_STORE
+ 	help
+ 	  ESP32 is a dual-core Xtensa-based IoT MCU from Espressif.
+ 	  Configured with FLASH and PSRAM it is capable of running noMMU Linux.
+
+ endchoice
+
+ config ESP32_INTC
+ 	bool
+ 	select IRQ_DOMAIN_HIERARCHY
 
 config PLATFORM_NR_IRQS
 	int
--- a/arch/xtensa/Makefile
+++ b/arch/xtensa/Makefile
@@ -26,6 +26,7 @@
 
 # Platform configuration
 
+platform-$(CONFIG_XTENSA_PLATFORM_ESP32)	:= esp32
 platform-$(CONFIG_XTENSA_PLATFORM_XT2000)	:= xt2000
 platform-$(CONFIG_XTENSA_PLATFORM_ISS)		:= iss
 platform-$(CONFIG_XTENSA_PLATFORM_XTFPGA)	:= xtfpga
--- a/arch/xtensa/include/asm/processor.h
+++ b/arch/xtensa/include/asm/processor.h
@@ -105,7 +105,7 @@
 #error Unsupported xtensa ABI
 #endif
 
-#ifndef __ASSEMBLER__
+#ifndef __ASSEMBLY__
 
 #if defined(__XTENSA_WINDOWED_ABI__)
 
--- a/arch/xtensa/platforms/iss/console.c
+++ b/arch/xtensa/platforms/iss/console.c
@@ -101,6 +101,7 @@
 	.proc_show = rs_proc_show,
 };
 
+#ifdef CONFIG_XTENSA_PLATFORM_ISS
 static int __init rs_init(void)
 {
 	struct tty_driver *driver;
@@ -140,6 +141,7 @@
 
 	return 0;
 }
+#endif /* CONFIG_XTENSA_PLATFORM_ISS */
 
 
 static __exit void rs_exit(void)
@@ -159,7 +161,9 @@
  * `module_init' to declare their init routines are likely to be broken.
  */
 
+#ifdef CONFIG_XTENSA_PLATFORM_ISS
 late_initcall(rs_init);
+#endif
 
 
 #ifdef CONFIG_SERIAL_CONSOLE
--- /dev/null
+++ b/arch/xtensa/platforms/esp32/include/platform/serial.h
@@ -0,0 +1,8 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#ifndef __ASM_XTENSA_ESP32_SERIAL_H
+#define __ASM_XTENSA_ESP32_SERIAL_H
+
+#define BASE_BAUD 115200
+
+#endif /* __ASM_XTENSA_ESP32_SERIAL_H */
