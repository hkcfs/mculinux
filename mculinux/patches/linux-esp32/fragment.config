# ESP32-S3 fragment: our deltas on top of upstream tinyconfig.
# Applied with:  make ARCH=xtensa tinyconfig
#                scripts/kconfig/merge_config.sh -m .config <this file>
#                make ARCH=xtensa olddefconfig
# Base = upstream (always fresh, no stale baggage). This file = everything
# the board actually needs. Later entries win; plain comments are ignored.
#
# Diet notes (memory experiments E0-E9, see docs/OPTIMIZATION-EXPERIMENTS.md):
# - SYSFS stays OFF (E5: +1.16M MemFree). init's sysfs mount fails harmlessly.
# - SLUB_TINY, LOG_BUF_SHIFT=12, BASE_SMALL, KALLSYMS off (E-series findings).
# - JFFS2_FS is ON: /etc (mtdblock3) must actually mount (init mounts it RW).

CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PREEMPT=y
CONFIG_VIRT_CPU_ACCOUNTING_GEN=y
CONFIG_LOG_BUF_SHIFT=12
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_EXPERT=y
# CONFIG_FHANDLE is not set
CONFIG_BASE_SMALL=y
# CONFIG_EPOLL is not set
# CONFIG_SIGNALFD is not set
# CONFIG_TIMERFD is not set
# CONFIG_AIO is not set
# CONFIG_IO_URING is not set
# CONFIG_ADVISE_SYSCALLS is not set
# CONFIG_MEMBARRIER is not set
# CONFIG_KALLSYMS is not set
CONFIG_XTENSA_VARIANT_CUSTOM=y
CONFIG_XTENSA_VARIANT_CUSTOM_NAME="esp32s3"
# CONFIG_XTENSA_VARIANT_MMU is not set
CONFIG_XTENSA_UNALIGNED_USER=y
CONFIG_KERNEL_ABI_CALL0=y
CONFIG_USER_ABI_CALL0_ONLY=y
CONFIG_XTENSA_PLATFORM_ESP32=y
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="earlycon=esp32s3uart,mmio32,0x60000000,115200n8,40000000 console=ttyS0,115200n8 debug loglevel=8"
CONFIG_USE_OF=y
CONFIG_BUILTIN_DTB_NAME="esp32s3-devkit-c1"
CONFIG_MEMMAP_CACHEATTR=0xffff222f
CONFIG_KERNEL_LOAD_ADDRESS=0x42120000
CONFIG_XTENSA_VECTORS_SEPARATE=y
CONFIG_VECTORS_ADDR=0x4037c000
CONFIG_XIP_DATA_ADDR=0x3d800000
CONFIG_DEFAULT_MEM_START=0x3d800000
# CONFIG_SECCOMP is not set
# CONFIG_STACKPROTECTOR is not set
# CONFIG_COREDUMP is not set
# Core essentials tinyconfig drops (verified by diffing against the booting
# 7.2 config — every line here is load-bearing: no PRINTK = silent kernel,
# no PARSE_BOOTPARAM = cmdline ignored, no BLOCK = no mtdblock root).
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_MULTIUSER=y
CONFIG_POSIX_TIMERS=y
CONFIG_RT_MUTEXES=y
CONFIG_FUTEX=y
CONFIG_FUTEX_PI=y
CONFIG_EVENTFD=y
CONFIG_FILE_LOCKING=y
CONFIG_PARSE_BOOTPARAM=y
CONFIG_SYSCTL=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_COMPAT_BRK=y
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_CACHESTAT_SYSCALL=y
CONFIG_DEVMEM=y
CONFIG_SLUB_TINY=y
CONFIG_MMAP_ALLOW_UNINITIALIZED=y
# CONFIG_VM_EVENT_COUNTERS is not set
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# CONFIG_STANDALONE is not set
# CONFIG_PREVENT_FIRMWARE_BUILD is not set
# CONFIG_FW_LOADER is not set
# CONFIG_ALLOW_DEV_COREDUMP is not set
CONFIG_MTD=y
# CONFIG_MTD_OF_PARTS is not set
CONFIG_MTD_BLOCK=y
CONFIG_MTD_BLKDEVS=y
CONFIG_MTD_ESP32=y
CONFIG_MTD_PHYSMAP=y
CONFIG_MTD_PHYSMAP_OF=y
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_BLOCK_LEGACY_AUTOLOAD=y
CONFIG_BLK_DEV_WRITE_MOUNTED=y
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_MQ_IOSCHED_KYBER=y
CONFIG_SBITMAP=y
CONFIG_ESP32_IPC=y
# Stage 2 (lean Ethernet): plain netdev over IPC slot 1 (esp32-wifi-shmem).
# Costs ~1.1MB (the E6 saving, reversed) — still fits the 3904K partition.
# udhcpc is already in busybox; SLAAC needs IPV6; PACKET for DHCP sockets.
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_NETLINK=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_ESP32_WIFI_SHMEM=y
# CONFIG_INPUT is not set
# CONFIG_SERIO is not set
# CONFIG_VT is not set
# CONFIG_UNIX98_PTYS is not set
# CONFIG_LEGACY_PTYS is not set
# CONFIG_LDISC_AUTOLOAD is not set
CONFIG_TTY=y
CONFIG_LEGACY_TIOCSTI=y
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_ESP32=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_SINGLE=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_GENERIC_PLATFORM=y
CONFIG_GPIO_ESP32S3=y
CONFIG_GPIO_CDEV=y
# MCU buses (Stage 1): i2c-gpio bit-bang over GPIO6/7 (DT i2c0 node exists).
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_GPIO=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON=y
# CONFIG_HWMON is not set
CONFIG_USB_ROLE_SWITCH=y
CONFIG_USB_SUPPORT=y
# CONFIG_VIRTIO_MENU is not set
# CONFIG_VHOST_MENU is not set
CONFIG_IIO=y
CONFIG_IIO_BUFFER=y
CONFIG_IIO_TRIGGERED_BUFFER=y
CONFIG_RESET_CONTROLLER=y
CONFIG_RESET_SIMPLE=y
# CONFIG_NVMEM is not set
# CONFIG_DNOTIFY is not set
# CONFIG_INOTIFY_USER is not set
# CONFIG_SYSFS is not set
CONFIG_MISC_FILESYSTEMS=y
CONFIG_CRAMFS=y
# CONFIG_CRAMFS_BLOCKDEV is not set
CONFIG_CRAMFS_MTD=y
CONFIG_FS_IOMAP=y
CONFIG_FS_POSIX_ACL=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_BACKED_BY_FILE=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_LZMA=y
CONFIG_EROFS_FS_ZIP_LZMA_DEFAULT_MAX_STREAMS=1
CONFIG_JFFS2_FS=y
# CONFIG_JFFS2_FS_XATTR is not set
# CONFIG_JFFS2_SUMMARY is not set
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_INIT_STACK_NONE=y
CONFIG_CRYPTO=y
# CONFIG_CRYPTO_HW is not set
CONFIG_XZ_DEC=y
CONFIG_XZ_DEC_MICROLZMA=y
CONFIG_ZLIB_INFLATE=y
CONFIG_LZ4_DECOMPRESS=y
CONFIG_XXHASH=y
CONFIG_CRC_OPTIMIZATIONS=y
# CONFIG_XZ_DEC_X86 is not set
# CONFIG_XZ_DEC_POWERPC is not set
# CONFIG_XZ_DEC_ARM is not set
# CONFIG_XZ_DEC_ARMTHUMB is not set
# CONFIG_XZ_DEC_ARM64 is not set
# CONFIG_XZ_DEC_SPARC is not set
# CONFIG_XZ_DEC_RISCV is not set
CONFIG_PRINTK_TIME=y
# CONFIG_SYMBOLIC_ERRNAME is not set
# CONFIG_DEBUG_MISC is not set
CONFIG_FRAME_WARN=1024
CONFIG_MAGIC_SYSRQ=y
CONFIG_STACKTRACE=y
# CONFIG_RCU_TRACE is not set
# CONFIG_FTRACE is not set
# CONFIG_LD_NO_RELAX is not set
# NOTE: keep "# CONFIG_X is not set" lines EXACT (no trailing comments) —
# merge_config.sh ignores anything that is not byte-exact.
# CONFIG_LD_DEAD_CODE_DATA_ELIMINATION is not set
# (E2: DCE hangs xtensa XIP right after sched_clock; tinyconfig enables it,
# so it must be turned back off here.)
CONFIG_SECTION_MISMATCH_WARN_ONLY=y
# CONFIG_S32C1I_SELFTEST is not set
CONFIG_PRINT_USER_CODE_ON_UNHANDLED_EXCEPTION=y
# CONFIG_RUNTIME_TESTING_MENU is not set
