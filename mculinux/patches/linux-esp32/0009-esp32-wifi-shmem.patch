From: MCUlinux <hkcfs@example.com>
Date: Tue, 9 Sep 2026 00:00:00 +0000
Subject: [PATCH 9/9] net: add ESP32-S3 WiFi over shared memory (lean Ethernet)

 Binds the wifi@1 child of esp,esp32-ipc (IPC client slot 1) as a plain
 Ethernet netdev. Frames cross cores in esp-hosted payload format through
 the IPC queues; Core 0 (ESP-IDF network_adapter) owns WPA/auth and the
 radio. Control path speaks the firmware command protocol (init/scan/
 connect via SIOCDEVPRIVATE, wificfg front-end).

--- a/drivers/net/ethernet/Kconfig
+++ b/drivers/net/ethernet/Kconfig
@@ -190,4 +190,16 @@
 source "drivers/net/ethernet/xilinx/Kconfig"
 source "drivers/net/ethernet/xircom/Kconfig"
 
+config ESP32_WIFI_SHMEM
+	tristate "Espressif ESP32-S3 WiFi over shared memory"
+	depends on NET && ESP32_IPC
+	help
+	  Plain-Ethernet netdev bound to the wifi@1 child of esp,esp32-ipc
+	  (IPC client slot 1). Frames cross cores in esp-hosted payload
+	  format through the IPC queues; Core 0 (ESP-IDF network_adapter)
+	  owns WPA/auth and the radio. Credentials and scan/connect are
+	  driven from Linux via SIOCDEVPRIVATE ioctls (see wificfg);
+	  secured connect needs the mculinux firmware passphrase
+	  extension (patches/esp-hosted/).
+
 endif # ETHERNET
--- a/drivers/net/ethernet/Makefile
+++ b/drivers/net/ethernet/Makefile
@@ -105,3 +105,4 @@
 obj-$(CONFIG_NET_VENDOR_SYNOPSYS) += synopsys/
 obj-$(CONFIG_NET_VENDOR_PENSANDO) += pensando/
 obj-$(CONFIG_OA_TC6) += oa_tc6.o
+obj-$(CONFIG_ESP32_WIFI_SHMEM) += esp32-wifi-shmem.o
--- /dev/null
+++ b/drivers/net/ethernet/esp32-wifi-shmem.c
@@ -0,0 +1,951 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Espressif ESP32-S3 WiFi over shared memory (lean Ethernet netdev).
+ *
+ * Binds the wifi@1 child of esp,esp32-ipc (IPC client slot 1) and exposes
+ * it as a plain Ethernet interface. Frames cross cores in esp-hosted
+ * payload format (esp_payload_header + 802.3 frame) through the IPC queues.
+ * Layout verified against esp_hosted_ng/host/include/adapter.h.
+ *
+ * Split-core model: Core 0 (ESP-IDF network_adapter) owns WPA/auth and the
+ * radio; Linux sees link-layer Ethernet. No supplicant, no cfg80211 here.
+ * Control path speaks the firmware's native command protocol
+ * (COMMAND_REQUEST init/scan/connect; COMMAND_RESPONSE + EVENTs back):
+ * wificfg drives scan (SSID/RSSI/channel/auth table) and connect.
+ * Secured connect needs the mculinux firmware passphrase extension.
+ *
+ * Buffer model: TX buffers are Linux-kmalloc'd and dcache-flushed before
+ * handoff (firmware invalidates on receive). RX buffers are
+ * firmware-owned; read through a per-packet uncached ioremap and validated
+ * before use. Accepted RX window is internal SRAM (firmware DRAM heap);
+ * anything outside is dropped and counted.
+ *
+ * Credentials: staged via SIOCDEVPRIVATE (see wificfg) for a future
+ * firmware connect command. Today the firmware uses its own config; the
+ * ioctl only stores the credentials and logs SSID receipt (never the
+ * passphrase). Carrier is assumed ON at open: no link signalling exists
+ * in this transport version.
+ */
+
+#include <linux/bitops.h>
+#include <linux/byteorder/generic.h>
+#include <linux/completion.h>
+#include <linux/errno.h>
+#include <linux/etherdevice.h>
+#include <linux/if_ether.h>
+#include <linux/io.h>
+#include <linux/jiffies.h>
+#include <linux/list.h>
+#include <linux/minmax.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/netdevice.h>
+#include <linux/of.h>
+#include <linux/of_device.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+#include <linux/sockios.h>
+#include <linux/spinlock.h>
+#include <linux/string.h>
+#include <linux/uaccess.h>
+
+#include <asm/cacheflush.h>
+#include <asm/page.h>
+#include <linux/esp32-ipc-api.h>
+
+/* Must match the firmware (esp_payload_header, packed, little-endian). */
+#define ESP_HDR_LEN		12
+#define ESP_IF_TYPE_STA		0
+#define ESP_PKT_TYPE_DATA	0
+#define ESP_PKT_CMD_REQ		1	/* == PACKET_TYPE_COMMAND_REQUEST */
+#define ESP_PKT_CMD_RESP	2	/* == PACKET_TYPE_COMMAND_RESPONSE */
+#define ESP_PKT_EVENT		3	/* == PACKET_TYPE_EVENT */
+#define ESP_MAX_FRAME		1600
+
+/* Firmware command protocol (network_adapter, esp-hosted NG widget).
+ * Host -> FW: COMMAND_REQUEST carrying command structs below; FW
+ * dispatches to its process_* handlers (init/scan/connect already
+ * exist in firmware). FW -> host on slot 1: COMMAND_RESPONSE with a
+ * command_header, or EVENTs (scan results, link status). No seq echo:
+ * one control transaction at a time (scan_lock), matched by cmd_code.
+ * Secured connect needs the mculinux firmware passphrase extension
+ * (patches/esp-hosted/); legacy firmware ignores the appended bytes
+ * and falls back to its own configured passphrase.
+ */
+#define ESP_CMD_INIT_IF		1	/* CMD_INIT_INTERFACE */
+#define ESP_CMD_GET_MAC		3	/* CMD_GET_MAC */
+#define ESP_CMD_SCAN		4	/* CMD_SCAN_REQUEST */
+#define ESP_CMD_CONNECT		5	/* CMD_STA_CONNECT */
+
+#define ESP_RESP_SUCCESS	2	/* CMD_RESPONSE_SUCCESS */
+
+#define ESP_EVT_SCAN_RESULT	1	/* EVENT_SCAN_RESULT */
+#define ESP_EVT_STA_CONNECT	2
+#define ESP_EVT_STA_DISCONNECT	3
+
+#define ESP32_WIFI_SCAN_MAX	32
+#define ESP32_WIFI_SCAN_TIMEOUT	(8 * HZ)
+#define ESP32_WIFI_CMD_TIMEOUT	(5 * HZ)
+
+/* Firmware DRAM heap window (internal SRAM). RX pointers outside are dropped. */
+#define FW_DRAM_BEGIN		0x3fc80000u
+#define FW_DRAM_END		0x3fd00000u
+
+/* IPC client slots on our side; must match firmware (ESP_IPC_WIFI_ADDR=1). */
+#define ESP32_IPC_CLIENTS_MAX	4
+
+struct esp_ipc_wifi_hdr {
+	u8 if_type_num;		/* if_num << 4 | if_type */
+	u8 flags;
+	u8 packet_type;
+	u8 reserved1;
+	__le16 len;		/* payload length */
+	__le16 offset;		/* header length (12) */
+	__le16 checksum;	/* byte sum over header + payload */
+	u8 reserved2;
+} __packed;
+
+struct esp32_wifi_cfg {
+	u8 ssid[32];
+	u8 ssid_len;
+	u8 pass[64];
+	u8 pass_len;
+};
+
+struct esp32_wifi_net {
+	u8 ssid[32];
+	u8 ssid_len;
+	s8 rssi;
+	u8 channel;
+	u8 auth;	/* 0 open, 1 WEP, 2 WPA, 3 WPA2, 4 WPA3, 255 unknown */
+	u8 bssid[6];
+	u8 pad[2];
+};
+
+struct esp32_wifi_scan {
+	u32 max;	/* in: capacity of nets */
+	u32 count;	/* out: networks found */
+	struct esp32_wifi_net nets[ESP32_WIFI_SCAN_MAX];
+};
+
+struct esp_cmd_header {
+	u8 cmd_code;
+	u8 cmd_status;
+	__le16 len;
+	__le16 seq;
+	u8 r1, r2;
+} __packed;
+
+struct esp_fw_scan_req {
+	struct esp_cmd_header h;
+	u8 bssid[6];
+	__le16 duration;
+	char ssid[33];
+	u8 channel;
+	u8 pad[2];
+} __packed;
+
+struct esp_fw_connect_req {
+	struct esp_cmd_header h;
+	u8 bssid[6];
+	__le16 assoc_flags;
+	char ssid[33];
+	u8 channel;
+	u8 is_open;
+	u8 assoc_ie_len;
+	char passphrase[65];	/* mculinux: NUL-padded PSK; legacy fw ignores */
+} __packed;
+
+struct esp_event_header {
+	u8 code;
+	u8 status;
+	__le16 len;
+} __packed;
+
+struct esp32_wifi_tx {
+	struct list_head list;
+	u32 tag;
+	void *buf;
+};
+
+struct esp32_wifi {
+	struct net_device *dev;
+	void *ipc;
+	u32 slot;
+	spinlock_t tx_lock;	/* pending list + tx stats + scan state */
+	struct list_head tx_pending;
+	struct net_device_stats stats;
+	struct esp32_wifi_cfg creds;
+	struct mutex scan_lock;	/* one control ioctl at a time */
+	struct completion scan_done;	/* scan results complete */
+	struct completion cmd_done;	/* command response arrived */
+	bool inited;		/* CMD_INIT_IF accepted by firmware */
+	bool cmd_waiting;
+	u8 cmd_code;
+	u8 cmd_status;
+	u8 resp_buf[16];	/* last command response payload (capped) */
+	u8 resp_len;
+	bool scanning;
+	u32 scan_count;
+	struct esp32_wifi_net scan_nets[ESP32_WIFI_SCAN_MAX];
+	struct esp32_wifi_tx *scan_req;	/* in-flight control frame */
+	bool dead;
+};
+
+static u16 esp_checksum(const u8 *buf, u16 len)
+{
+	u16 sum = 0, i;
+
+	for (i = 0; i < len; ++i)
+		sum += buf[i];
+	return sum;
+}
+
+static void esp32_wifi_reap(struct esp32_wifi *priv, u32 done)
+{
+	struct esp32_wifi_tx *e, *tmp;
+	unsigned long flags;
+
+	spin_lock_irqsave(&priv->tx_lock, flags);
+	list_for_each_entry_safe(e, tmp, &priv->tx_pending, list) {
+		/* 'done' is the last tag completed by firmware: reap it too. */
+		if ((s32)(done - e->tag) >= 0) {
+			list_del(&e->list);
+			if (e == priv->scan_req)
+				priv->scan_req = NULL;
+			kfree(e->buf);
+			kfree(e);
+		}
+	}
+	if (!list_empty(&priv->tx_pending))
+		netif_wake_queue(priv->dev);
+	spin_unlock_irqrestore(&priv->tx_lock, flags);
+}
+
+static void esp32_wifi_cmd_rx(struct esp32_wifi *priv, void __iomem *map,
+			      u16 offset, u16 len);
+static void esp32_wifi_event_rx(struct esp32_wifi *priv, void __iomem *map,
+				u16 offset, u16 len);
+
+/* Firmware -> Linux path. Runs in the IPC thread (process context). */
+static int esp32_wifi_rx(void *p, void *data)
+{
+	struct esp32_wifi *priv = p;
+	struct esp_ipc_wifi_hdr hdr;
+	struct sk_buff *skb;
+	void __iomem *map;
+	phys_addr_t addr = (phys_addr_t)(uintptr_t)data;
+	u16 len, offset;
+	void *copy;
+
+	if (priv->dead)
+		return 0;
+	if (!data)
+		return 1;
+
+	/* Accept only firmware-DRAM pointers; everything else is dropped. */
+	if (addr < FW_DRAM_BEGIN || addr >= FW_DRAM_END) {
+		priv->stats.rx_dropped++;
+		return 1;
+	}
+
+	map = ioremap(addr, ESP_HDR_LEN);
+	if (!map) {
+		priv->stats.rx_dropped++;
+		return 1;
+	}
+	memcpy_fromio(&hdr, map, ESP_HDR_LEN);
+	iounmap(map);
+
+	len = le16_to_cpu(hdr.len);
+	offset = le16_to_cpu(hdr.offset);
+	if (offset != ESP_HDR_LEN || len > ESP_MAX_FRAME) {
+		priv->stats.rx_dropped++;
+		return 1;
+	}
+	if (addr + offset + len > FW_DRAM_END) {
+		priv->stats.rx_dropped++;
+		return 1;
+	}
+
+	map = ioremap(addr, offset + len);
+	if (!map) {
+		priv->stats.rx_dropped++;
+		return 1;
+	}
+	if (hdr.packet_type == ESP_PKT_CMD_RESP) {
+		esp32_wifi_cmd_rx(priv, map, offset, len);
+		iounmap(map);
+		return 1;
+	}
+	if (hdr.packet_type == ESP_PKT_EVENT) {
+		esp32_wifi_event_rx(priv, map, offset, len);
+		iounmap(map);
+		return 1;
+	}
+	if (hdr.packet_type != ESP_PKT_TYPE_DATA || len < ETH_HLEN) {
+		iounmap(map);
+		priv->stats.rx_dropped++;
+		return 1;
+	}
+	skb = dev_alloc_skb(len + NET_IP_ALIGN);
+	if (!skb) {
+		iounmap(map);
+		priv->stats.rx_dropped++;
+		return 1;
+	}
+	skb_reserve(skb, NET_IP_ALIGN);
+	copy = skb_put(skb, len);
+	memcpy_fromio(copy, map + offset, len);
+	iounmap(map);
+
+	skb->protocol = eth_type_trans(skb, priv->dev);
+	priv->stats.rx_packets++;
+	priv->stats.rx_bytes += len;
+	netif_rx(skb);
+	return 1;
+}
+
+/* Write-queue drain state from firmware: free our consumed TX buffers. */
+static void esp32_wifi_rx_batch_done(void *p, u32 tag)
+{
+	struct esp32_wifi *priv = p;
+
+	if (!priv->dead)
+		esp32_wifi_reap(priv, tag);
+}
+
+static netdev_tx_t esp32_wifi_xmit(struct sk_buff *skb, struct net_device *dev)
+{
+	struct esp32_wifi *priv = netdev_priv(dev);
+	struct esp_ipc_wifi_hdr *hdr;
+	struct esp32_wifi_tx *e;
+	u8 *buf;
+	u32 tag;
+	unsigned int len;
+	int ret;
+	unsigned long flags;
+
+	if (skb->len > ESP_MAX_FRAME) {
+		dev_kfree_skb(skb);
+		priv->stats.tx_dropped++;
+		return NETDEV_TX_OK;
+	}
+	len = skb->len;
+
+	buf = kmalloc(ESP_HDR_LEN + len, GFP_ATOMIC);
+	if (!buf) {
+		dev_kfree_skb(skb);
+		priv->stats.tx_dropped++;
+		return NETDEV_TX_OK;
+	}
+	e = kmalloc(sizeof(*e), GFP_ATOMIC);
+	if (!e) {
+		kfree(buf);
+		dev_kfree_skb(skb);
+		priv->stats.tx_dropped++;
+		return NETDEV_TX_OK;
+	}
+
+	hdr = (struct esp_ipc_wifi_hdr *)buf;
+	hdr->if_type_num = (0 << 4) | ESP_IF_TYPE_STA;
+	hdr->flags = 0;
+	hdr->packet_type = ESP_PKT_TYPE_DATA;
+	hdr->reserved1 = 0;
+	hdr->len = cpu_to_le16(len);
+	hdr->offset = cpu_to_le16(ESP_HDR_LEN);
+	hdr->reserved2 = 0;
+	/* Checksum covers header+payload: zero our own field first. */
+	hdr->checksum = 0;
+	skb_copy_from_linear_data(skb, buf + ESP_HDR_LEN, len);
+	hdr->checksum = cpu_to_le16(esp_checksum(buf, ESP_HDR_LEN + len));
+
+	/* Make the buffer visible to Core 0 before handing over the pointer. */
+	__flush_dcache_range((unsigned long)buf,
+			     (unsigned long)buf + ESP_HDR_LEN + len);
+
+	ret = esp32_ipc_tx(priv->ipc, priv->slot, (void *)__pa(buf), &tag);
+	dev_kfree_skb(skb);
+	if (ret) {
+		/* skb already freed: count the error, never return BUSY. */
+		kfree(e);
+		kfree(buf);
+		spin_lock_irqsave(&priv->tx_lock, flags);
+		priv->stats.tx_errors++;
+		spin_unlock_irqrestore(&priv->tx_lock, flags);
+		return NETDEV_TX_OK;
+	}
+
+	e->tag = tag;
+	e->buf = buf;
+	spin_lock_irqsave(&priv->tx_lock, flags);
+	list_add_tail(&e->list, &priv->tx_pending);
+	priv->stats.tx_packets++;
+	priv->stats.tx_bytes += len;
+	spin_unlock_irqrestore(&priv->tx_lock, flags);
+	return NETDEV_TX_OK;
+}
+
+static int esp32_wifi_open(struct net_device *dev)
+{
+	/* No link signalling in this transport version; assume link. */
+	netif_carrier_on(dev);
+	netif_start_queue(dev);
+	return 0;
+}
+
+static int esp32_wifi_stop(struct net_device *dev)
+{
+	netif_carrier_off(dev);
+	netif_stop_queue(dev);
+	return 0;
+}
+
+static void esp32_wifi_timeout(struct net_device *dev, unsigned int txqueue)
+{
+	struct esp32_wifi *priv = netdev_priv(dev);
+	unsigned long flags;
+
+	spin_lock_irqsave(&priv->tx_lock, flags);
+	priv->stats.tx_errors++;
+	spin_unlock_irqrestore(&priv->tx_lock, flags);
+	netif_wake_queue(dev);
+}
+
+static int esp32_wifi_mac(struct net_device *dev, void *addr)
+{
+	return eth_mac_addr(dev, addr);
+}
+
+/* Pull SSID + auth out of an 802.11 beacon/probe-response frame. */
+static u8 esp32_wifi_ssid_from_frame(const u8 *frame, u16 frame_len,
+				     u8 *ssid, u8 *auth)
+{
+	u16 pos = 24 + 12;	/* mgmt header + beacon fixed params */
+	u8 found = 0, privacy = 0, slen = 0;
+
+	*auth = 0;
+	if (frame_len < pos + 2)
+		return 0;
+	privacy = (frame[24 + 10] & 0x10) != 0;
+	while (pos + 2 <= frame_len) {
+		u8 id = frame[pos], elen = frame[pos + 1];
+		const u8 *e;
+		u16 pcnt, acnt, i;
+
+		if (pos + 2 + elen > frame_len)
+			break;
+		e = frame + pos + 2;
+		if (id == 0 && elen <= 32 && !slen) {
+			memcpy(ssid, e, elen);
+			slen = elen;
+		} else if (id == 48 && elen >= 8) {
+			found = 3;	/* RSN: WPA2 unless SAE AKM appears */
+			pcnt = e[6] | (e[7] << 8);
+			e += 8 + 4 * pcnt;
+			if (e + 2 <= frame + pos + 2 + elen) {
+				acnt = e[0] | (e[1] << 8);
+				e += 2;
+				for (i = 0; i < acnt &&
+				     e + 4 <= frame + pos + 2 + elen;
+				     i++, e += 4)
+					if (!memcmp(e, "\x00\x0f\xac\x08", 4))
+						found = 4;
+			}
+		} else if (id == 221 && elen >= 4 &&
+			   !memcmp(e, "\x00\x50\xf2\x01", 4) && !found) {
+			found = 2;
+		}
+		pos += 2 + elen;
+	}
+	*auth = found ? found : (privacy ? 1 : 0);
+	return slen;
+}
+
+/* Firmware -> Linux command responses. Runs in the IPC thread. */
+static void esp32_wifi_cmd_rx(struct esp32_wifi *priv, void __iomem *map,
+			      u16 offset, u16 len)
+{
+	struct esp_cmd_header ch;
+	unsigned long flags;
+
+	if (len < sizeof(ch))
+		return;
+	memcpy_fromio(&ch, map + offset, sizeof(ch));
+	spin_lock_irqsave(&priv->tx_lock, flags);
+	if (priv->cmd_waiting && ch.cmd_code == priv->cmd_code) {
+		priv->cmd_status = ch.cmd_status;
+		priv->resp_len = min(len, (u16)sizeof(priv->resp_buf));
+		memcpy_fromio(priv->resp_buf, map + offset, priv->resp_len);
+		priv->cmd_waiting = false;
+		spin_unlock_irqrestore(&priv->tx_lock, flags);
+		complete(&priv->cmd_done);
+	} else {
+		spin_unlock_irqrestore(&priv->tx_lock, flags);
+	}
+}
+
+/* One EVENT_SCAN_RESULT frame -> result slot. Runs in the IPC thread. */
+static void esp32_wifi_scan_result_rx(struct esp32_wifi *priv,
+				      void __iomem *map, u16 offset, u16 len)
+{
+	struct {
+		struct esp_event_header h;
+		u8 bssid[6];
+		u8 frame_type, channel;
+		__le32 rssi;
+		__le64 tsf;
+		__le16 frame_len;
+		u8 pad[2];
+	} e;
+	u8 frame[256], ssid[32], auth, slen;
+	unsigned long flags;
+	u32 i;
+	u16 flen, avail, take;
+
+	if (len < 28)
+		return;
+	memcpy_fromio(&e, map + offset, 28);
+	if (e.h.code != ESP_EVT_SCAN_RESULT)
+		return;
+	flen = le16_to_cpu(e.frame_len);
+	avail = len - 28;
+	take = flen;
+	if (take > avail)
+		take = avail;
+	if (take > sizeof(frame))
+		take = sizeof(frame);
+	if (take)
+		memcpy_fromio(frame, map + offset + 28, take);
+	slen = esp32_wifi_ssid_from_frame(frame, take, ssid, &auth);
+	spin_lock_irqsave(&priv->tx_lock, flags);
+	if (!priv->scanning) {
+		spin_unlock_irqrestore(&priv->tx_lock, flags);
+		return;
+	}
+	for (i = 0; i < priv->scan_count; i++)
+		if (!memcmp(priv->scan_nets[i].bssid, e.bssid, 6))
+			break;
+	if (i == priv->scan_count && priv->scan_count < ESP32_WIFI_SCAN_MAX) {
+		struct esp32_wifi_net *n = &priv->scan_nets[priv->scan_count++];
+		memcpy(n->bssid, e.bssid, 6);
+		memcpy(n->ssid, ssid, slen);
+		n->ssid_len = slen;
+		n->rssi = (s8)(s32)le32_to_cpu(e.rssi);
+		n->channel = e.channel;
+		n->auth = auth;
+	}
+	spin_unlock_irqrestore(&priv->tx_lock, flags);
+}
+
+/* Firmware -> Linux events (scan results, link status). IPC thread. */
+static void esp32_wifi_event_rx(struct esp32_wifi *priv, void __iomem *map,
+				u16 offset, u16 len)
+{
+	struct esp_event_header eh;
+	unsigned long flags;
+
+	if (len < sizeof(eh))
+		return;
+	memcpy_fromio(&eh, map + offset, sizeof(eh));
+	if (eh.code == ESP_EVT_SCAN_RESULT) {
+		esp32_wifi_scan_result_rx(priv, map, offset, len);
+	} else if (eh.code == ESP_EVT_STA_CONNECT) {
+		netdev_info(priv->dev, "firmware: station connected (status %u)\n",
+			    eh.status);
+	} else if (eh.code == ESP_EVT_STA_DISCONNECT) {
+		netdev_info(priv->dev, "firmware: station disconnected (status %u)\n",
+			    eh.status);
+	} else if (eh.code == 0 && len == sizeof(eh)) {
+		/* Scan-done marker (empty event from firmware). */
+		spin_lock_irqsave(&priv->tx_lock, flags);
+		if (priv->scanning) {
+			priv->scanning = false;
+			spin_unlock_irqrestore(&priv->tx_lock, flags);
+			complete(&priv->scan_done);
+		} else {
+			spin_unlock_irqrestore(&priv->tx_lock, flags);
+		}
+	}
+}
+
+/* Send one control frame; tracks it for reap/timeout cleanup. */
+static int esp32_wifi_cmd_tx(struct esp32_wifi *priv, const void *pl,
+			     u16 pl_len)
+{
+	struct esp_ipc_wifi_hdr *hdr;
+	struct esp32_wifi_tx *e;
+	u8 *buf;
+	u32 tag;
+	unsigned long flags;
+	int ret;
+
+	buf = kmalloc(ESP_HDR_LEN + pl_len, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+	e = kmalloc(sizeof(*e), GFP_KERNEL);
+	if (!e) {
+		kfree(buf);
+		return -ENOMEM;
+	}
+	memcpy(buf + ESP_HDR_LEN, pl, pl_len);
+	hdr = (struct esp_ipc_wifi_hdr *)buf;
+	hdr->if_type_num = (0 << 4) | ESP_IF_TYPE_STA;
+	hdr->flags = 0;
+	hdr->packet_type = ESP_PKT_CMD_REQ;
+	hdr->reserved1 = 0;
+	hdr->len = cpu_to_le16(pl_len);
+	hdr->offset = cpu_to_le16(ESP_HDR_LEN);
+	hdr->reserved2 = 0;
+	hdr->checksum = 0;
+	hdr->checksum = cpu_to_le16(esp_checksum(buf, ESP_HDR_LEN + pl_len));
+	__flush_dcache_range((unsigned long)buf,
+			     (unsigned long)buf + ESP_HDR_LEN + pl_len);
+	ret = esp32_ipc_tx(priv->ipc, priv->slot, (void *)__pa(buf), &tag);
+	spin_lock_irqsave(&priv->tx_lock, flags);
+	if (ret) {
+		priv->stats.tx_errors++;
+		spin_unlock_irqrestore(&priv->tx_lock, flags);
+		kfree(e);
+		kfree(buf);
+		return -EIO;
+	}
+	e->tag = tag;
+	e->buf = buf;
+	list_add_tail(&e->list, &priv->tx_pending);
+	priv->scan_req = e;
+	spin_unlock_irqrestore(&priv->tx_lock, flags);
+	return 0;
+}
+
+/* Drop the tracked control frame (reaped already? no-op). */
+static void esp32_wifi_cmd_unlink(struct esp32_wifi *priv)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&priv->tx_lock, flags);
+	if (priv->scan_req) {
+		list_del(&priv->scan_req->list);
+		kfree(priv->scan_req->buf);
+		kfree(priv->scan_req);
+		priv->scan_req = NULL;
+	}
+	spin_unlock_irqrestore(&priv->tx_lock, flags);
+}
+
+/* One COMMAND_REQUEST round trip. Caller holds scan_lock. */
+static int esp32_wifi_cmd(struct esp32_wifi *priv, u8 cmd_code,
+			  const void *pl, u16 pl_len)
+{
+	unsigned long flags, left;
+	int status;
+
+	spin_lock_irqsave(&priv->tx_lock, flags);
+	priv->cmd_waiting = true;
+	priv->cmd_code = cmd_code;
+	priv->cmd_status = 0xff;
+	spin_unlock_irqrestore(&priv->tx_lock, flags);
+	init_completion(&priv->cmd_done);
+	status = esp32_wifi_cmd_tx(priv, pl, pl_len);
+	if (status)
+		goto out;
+	left = wait_for_completion_timeout(&priv->cmd_done,
+					   ESP32_WIFI_CMD_TIMEOUT);
+	spin_lock_irqsave(&priv->tx_lock, flags);
+	status = priv->cmd_status;
+	spin_unlock_irqrestore(&priv->tx_lock, flags);
+	if (!left)
+		return -ETIMEDOUT;
+	return (status == ESP_RESP_SUCCESS) ? 0 : -EIO;
+out:
+	spin_lock_irqsave(&priv->tx_lock, flags);
+	priv->cmd_waiting = false;
+	spin_unlock_irqrestore(&priv->tx_lock, flags);
+	return status;
+}
+
+/* Lazily bring firmware wifi up (idempotent in firmware). */
+static int esp32_wifi_ensure_inited(struct esp32_wifi *priv)
+{
+	struct esp_cmd_header h;
+	unsigned long flags;
+	bool need;
+	int ret;
+
+	spin_lock_irqsave(&priv->tx_lock, flags);
+	need = !priv->inited;
+	spin_unlock_irqrestore(&priv->tx_lock, flags);
+	if (!need)
+		return 0;
+	memset(&h, 0, sizeof(h));
+	h.cmd_code = ESP_CMD_INIT_IF;
+	ret = esp32_wifi_cmd(priv, ESP_CMD_INIT_IF, &h, sizeof(h));
+	esp32_wifi_cmd_unlink(priv);
+	if (!ret) {
+		spin_lock_irqsave(&priv->tx_lock, flags);
+		priv->inited = true;
+		spin_unlock_irqrestore(&priv->tx_lock, flags);
+	}
+	return ret;
+}
+
+/* wificfg scan: broadcast scan via firmware, collect result events. */
+static int esp32_wifi_scan(struct net_device *dev, void __user *data)
+{
+	struct esp32_wifi *priv = netdev_priv(dev);
+	struct esp32_wifi_scan __user *up = data;
+	struct esp_fw_scan_req req;
+	u32 max, count;
+	unsigned long flags, left;
+	int ret;
+
+	if (copy_from_user(&max, &up->max, sizeof(max)))
+		return -EFAULT;
+	if (max == 0 || max > ESP32_WIFI_SCAN_MAX)
+		return -EINVAL;
+	if (!mutex_trylock(&priv->scan_lock))
+		return -EBUSY;
+	ret = esp32_wifi_ensure_inited(priv);
+	if (ret)
+		goto out;
+	memset(&req, 0, sizeof(req));
+	req.h.cmd_code = ESP_CMD_SCAN;
+	spin_lock_irqsave(&priv->tx_lock, flags);
+	priv->scanning = true;
+	priv->scan_count = 0;
+	spin_unlock_irqrestore(&priv->tx_lock, flags);
+	init_completion(&priv->scan_done);
+	ret = esp32_wifi_cmd(priv, ESP_CMD_SCAN, &req, sizeof(req));
+	esp32_wifi_cmd_unlink(priv);
+	if (ret) {
+		spin_lock_irqsave(&priv->tx_lock, flags);
+		priv->scanning = false;
+		spin_unlock_irqrestore(&priv->tx_lock, flags);
+		goto out;
+	}
+	left = wait_for_completion_timeout(&priv->scan_done,
+					   ESP32_WIFI_SCAN_TIMEOUT);
+	spin_lock_irqsave(&priv->tx_lock, flags);
+	priv->scanning = false;
+	count = priv->scan_count;
+	if (count > max)
+		count = max;
+	spin_unlock_irqrestore(&priv->tx_lock, flags);
+	if (!left && !count) {
+		netdev_info(dev, "scan: no results (firmware silent or no radio)\n");
+		ret = -ETIMEDOUT;
+		goto out;
+	}
+	if (copy_to_user(&up->count, &count, sizeof(count)) ||
+	    (count && copy_to_user((void __user *)up->nets, priv->scan_nets,
+				   count * sizeof(struct esp32_wifi_net)))) {
+		ret = -EFAULT;
+		goto out;
+	}
+	ret = 0;
+out:
+	mutex_unlock(&priv->scan_lock);
+	return ret;
+}
+
+/* wificfg <ssid> [pass]: join that network via firmware. */
+static int esp32_wifi_connect(struct net_device *dev, void __user *data)
+{
+	struct esp32_wifi *priv = netdev_priv(dev);
+	struct esp32_wifi_cfg cfg;
+	struct esp_fw_connect_req req;
+	int ret;
+
+	if (copy_from_user(&cfg, data, sizeof(cfg)))
+		return -EFAULT;
+	if (cfg.ssid_len == 0 || cfg.ssid_len > 32 || cfg.pass_len > 64)
+		return -EINVAL;
+	if (!mutex_trylock(&priv->scan_lock))
+		return -EBUSY;
+	ret = esp32_wifi_ensure_inited(priv);
+	if (ret)
+		goto out;
+	memset(&req, 0, sizeof(req));
+	req.h.cmd_code = ESP_CMD_CONNECT;
+	memcpy(req.ssid, cfg.ssid, cfg.ssid_len);
+	req.channel = 0;	/* auto: join on any channel */
+	req.is_open = (cfg.pass_len == 0);
+	memcpy(req.passphrase, cfg.pass, cfg.pass_len);
+	ret = esp32_wifi_cmd(priv, ESP_CMD_CONNECT, &req, sizeof(req));
+	esp32_wifi_cmd_unlink(priv);
+	if (!ret)
+		netdev_info(dev, "connect request accepted for SSID '%.*s'\n",
+			    cfg.ssid_len, cfg.ssid);
+out:
+	mutex_unlock(&priv->scan_lock);
+	return ret;
+}
+
+/* wificfg mac: read the firmware STA MAC (no radio or INIT needed). */
+static int esp32_wifi_get_mac(struct net_device *dev, void __user *data)
+{
+	struct esp32_wifi *priv = netdev_priv(dev);
+	struct esp_cmd_header h;
+	unsigned long flags;
+	u8 mac[6];
+	int ret;
+
+	if (!mutex_trylock(&priv->scan_lock))
+		return -EBUSY;
+	memset(&h, 0, sizeof(h));
+	h.cmd_code = ESP_CMD_GET_MAC;
+	ret = esp32_wifi_cmd(priv, ESP_CMD_GET_MAC, &h, sizeof(h));
+	esp32_wifi_cmd_unlink(priv);
+	if (!ret) {
+		spin_lock_irqsave(&priv->tx_lock, flags);
+		if (priv->resp_len < 14) {
+			spin_unlock_irqrestore(&priv->tx_lock, flags);
+			mutex_unlock(&priv->scan_lock);
+			return -EIO;
+		}
+		memcpy(mac, priv->resp_buf + 8, 6);
+		spin_unlock_irqrestore(&priv->tx_lock, flags);
+		if (copy_to_user(data, mac, sizeof(mac)))
+			ret = -EFAULT;
+	}
+	mutex_unlock(&priv->scan_lock);
+	return ret;
+}
+
+static int esp32_wifi_siocdevprivate(struct net_device *dev,
+					struct ifreq *ifr, void __user *data,
+					int cmd)
+{
+	struct esp32_wifi *priv = netdev_priv(dev);
+	struct esp32_wifi_cfg cfg;
+
+	if (cmd != SIOCDEVPRIVATE && cmd != SIOCDEVPRIVATE + 1 &&
+	    cmd != SIOCDEVPRIVATE + 2 && cmd != SIOCDEVPRIVATE + 3)
+		return -EOPNOTSUPP;
+	if (cmd == SIOCDEVPRIVATE + 1)
+		return esp32_wifi_scan(dev, data);
+	if (cmd == SIOCDEVPRIVATE + 2)
+		return esp32_wifi_connect(dev, data);
+	if (cmd == SIOCDEVPRIVATE + 3)
+		return esp32_wifi_get_mac(dev, data);
+	if (copy_from_user(&cfg, data, sizeof(cfg)))
+		return -EFAULT;
+	if (cfg.ssid_len == 0 || cfg.ssid_len > sizeof(cfg.ssid) ||
+	    cfg.pass_len > sizeof(cfg.pass))
+		return -EINVAL;
+
+	memcpy(&priv->creds, &cfg, sizeof(cfg));
+	netdev_info(dev, "WiFi credentials staged for SSID '%.*s' (%u chars), passphrase %u chars (not shown)\n",
+		    cfg.ssid_len, cfg.ssid, cfg.ssid_len, cfg.pass_len);
+	netdev_info(dev, "note: firmware has no IPC connect command yet; credentials take effect with a future firmware (Part B)\n");
+	return 0;
+}
+
+static struct net_device_stats *
+esp32_wifi_stats(struct net_device *dev)
+{
+	struct esp32_wifi *priv = netdev_priv(dev);
+
+	return &priv->stats;
+}
+
+static const struct net_device_ops esp32_wifi_ops = {
+	.ndo_open		= esp32_wifi_open,
+	.ndo_stop		= esp32_wifi_stop,
+	.ndo_start_xmit		= esp32_wifi_xmit,
+	.ndo_tx_timeout		= esp32_wifi_timeout,
+	.ndo_set_mac_address	= esp32_wifi_mac,
+	.ndo_siocdevprivate	= esp32_wifi_siocdevprivate,
+	.ndo_get_stats		= esp32_wifi_stats,
+};
+
+static int esp32_wifi_probe(struct platform_device *pdev)
+{
+	struct device *parent = pdev->dev.parent;
+	struct esp32_wifi *priv;
+	struct net_device *dev;
+	void *ipc;
+	u32 slot;
+	int ret;
+
+	ipc = parent ? dev_get_drvdata(parent) : NULL;
+	if (!ipc)
+		return -EPROBE_DEFER;
+	if (of_property_read_u32(pdev->dev.of_node, "reg", &slot) ||
+	    slot >= ESP32_IPC_CLIENTS_MAX)
+		return -EINVAL;
+
+	dev = alloc_etherdev(sizeof(*priv));
+	if (!dev)
+		return -ENOMEM;
+	SET_NETDEV_DEV(dev, &pdev->dev);
+	priv = netdev_priv(dev);
+	priv->dev = dev;
+	priv->ipc = ipc;
+	priv->slot = slot;
+	spin_lock_init(&priv->tx_lock);
+	mutex_init(&priv->scan_lock);
+	INIT_LIST_HEAD(&priv->tx_pending);
+
+	eth_hw_addr_random(dev);
+	dev->netdev_ops = &esp32_wifi_ops;
+	dev->watchdog_timeo = 5 * HZ;
+
+	ret = register_netdev(dev);
+	if (ret) {
+		free_netdev(dev);
+		return ret;
+	}
+	ret = esp32_ipc_register_rx(ipc, slot, priv,
+				    esp32_wifi_rx, esp32_wifi_rx_batch_done);
+	if (ret) {
+		unregister_netdev(dev);
+		free_netdev(dev);
+		return ret;
+	}
+
+	platform_set_drvdata(pdev, priv);
+	netdev_info(dev, "ESP32-S3 WiFi shmem on IPC slot %u, MAC %pM\n",
+		    slot, dev->dev_addr);
+	return 0;
+}
+
+static void esp32_wifi_remove(struct platform_device *pdev)
+{
+	struct esp32_wifi *priv = platform_get_drvdata(pdev);
+	struct esp32_wifi_tx *e, *tmp;
+
+	if (!priv)
+		return;
+	priv->dead = true;
+	/* Wake any in-flight scan so remove never strands wificfg. */
+	complete_all(&priv->scan_done);
+	unregister_netdev(priv->dev);
+	list_for_each_entry_safe(e, tmp, &priv->tx_pending, list) {
+		list_del(&e->list);
+		kfree(e->buf);
+		kfree(e);
+	}
+	free_netdev(priv->dev);
+}
+
+static const struct of_device_id esp32_wifi_of_match[] = {
+	{ .compatible = "esp,esp32-wifi-shmem" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, esp32_wifi_of_match);
+
+static struct platform_driver esp32_wifi_driver = {
+	.probe = esp32_wifi_probe,
+	.remove = esp32_wifi_remove,
+	.driver = {
+		.name = "esp32-wifi-shmem",
+		.of_match_table = esp32_wifi_of_match,
+	},
+};
+module_platform_driver(esp32_wifi_driver);
+
+MODULE_LICENSE("GPL");
+MODULE_AUTHOR("MCUlinux");
+MODULE_DESCRIPTION("Espressif ESP32-S3 WiFi over shared memory (lean Ethernet)");
