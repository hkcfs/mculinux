# mculinux overlay appended to sdkconfig.trimmed at build time
# (see build-bootloader.sh). INFO firmware logs for Part B bringup:
# the command handlers (INIT/scan/connect) log at INFO level.
CONFIG_LOG_DEFAULT_LEVEL_ERROR=n
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL=3
# v6.0 renamed NONE->DEBUG via sdkconfig.rename (slow bootloader);
# restore the fork's small/fast intent.
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_SIZE=y
